<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Vendored SolLink fork of SS14.Starlight.NullLink (committed under vendor/nuget). -->
    <add key="vendor" value="vendor/nuget" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vendor">
      <package pattern="SS14.Starlight.NullLink" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="Microsoft.DotNet.RemoteExecutor" />
    </packageSource>
  </packageSourceMapping>
</configuration>
