( cat input.tal | uxncli drifloon.rom > output.rom )

|00 @System/vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|10 @Console/vector $2 &read $1 &pad $4 &type $1 &write $1 &error $1

|000

	@scope/buf $3f &cap $1
	@token/buf $3f &cap $1

|100

@on-reset ( -> )
	;meta #06 DEO2
	assembly/<init>
	;assembly/on-console .Console/vector DEO2
	BRK

@meta $1
	( name ) "Drifloon 0a
	( desc ) "Uxntal 20 "Assembler 0a
	( auth ) "By 20 "Devine 20 "Lu 20 "Linvega 0a
	( date ) "6 20 "Mar 20 "2026 0000

@assembly/on-console ( -> )
	[ LIT2 04 -Console/type ] DEI EQU ?{ .Console/read DEI token/<push-byte>
		BRK }
	#0a token/<push-byte>
	/<resolve>
	error/get ?{
		[ LIT2 80 -System/state ] DEO
		BRK }
	[ LIT2 01 -System/state ] DEO
	BRK

@rom/<put> ( byte addr* -- )
	;&mem ADD2 STA
	JMP2r

@rom/<emit> ( -- )
	;dict/assembled info/<print>
	;dict/in info/<print>
	;head/boundary LDA2 DUP2 #00ff SUB2 info/<pdec>
	;dict/bytes info/<print>
	( | write )
	;&mem INC2 ADD2 ;&output
	&>l
		LDAk #18 DEO
		INC2 GTH2k ?&>l
	POP2 POP2 JMP2r

@runes/concat ( t* -- )
	POP2 JMP2r

@info/<emit> ( c -- )
	#19 DEO
	JMP2r

~src/core.tal
