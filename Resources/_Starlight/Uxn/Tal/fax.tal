|00 @System/vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|f0 @Fax/status $1 &cmd $1 &bnk1len $2 &bnk1ptr $2 &bnk2len $2 &bnk2ptr $1

|100
( initial setup )
;mmu-atch-fax .System/expansion DEO2 ( attach the fax device )

( get CC's address )
;buf/size LDA2 .Fax/bnk1len DEO2 ( set the size of the first bank )
;buf/contents .Fax/bnk1ptr DEO2 ( set the pointer of the first bank )
01 .Fax/cmd DEO ( refresh the list of faxes )
02 .Fax/cmd DEO ( dump the first fax to  buffer. it SHOULD always be CC due to loading order... I hope... which means this is basically advanced string processing )

00 .System/debug DEO ( hit that breakpoint! )

( prepare our hello the address )
;dict/hello .Fax/bnk2ptr DEO2 ( hello world is null-terminated so we can just use null-length to get the whole string )
0000 .Fax/bnk2len DEO2
;buf/addr .Fax/bnk1ptr DEO2
0000 .Fax/bnk1len DEO2 ( since the addr is null-terminated we can just set the length to 0 to read the whole thing )
03 .Fax/cmd DEO ( SEND IT! )

@dict
&fax-name "FaxMachine $1
&hello "Hello 20 "World $1
@mmu-atch-fax 03 =dict/fax-name 0f

@buf &size $1 _{ &contents "Central 20 "Command $1 &addr [ $4 "- $4 ] $1 } (these last 4 are the device address)