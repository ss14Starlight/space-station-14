|00 @System/vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|f0 @Fax/status $1 &cmd $1 &bnk1len $2 &bnk1ptr $2 &bnk2len $2 &bnk2ptr $1

|100
( initial setup )
;mmu-atch-fax .System/expansion DEO2 ( attach the fax device )

( fax is ready! )
;dict/title .Fax/bnk1ptr DEO2
#0000 .Fax/bnk1len DEO2
;dict/contents .Fax/bnk2ptr DEO2
#0000 .Fax/bnk2len DEO2
#04 .Fax/cmd DEO ( SEND IT! )

@dict
&fax-name "faxmachine $1
&title "Hello 20 "Central 20 "Command $1
&contents "Hello 20 "World! $1
@mmu-atch-fax 03 =dict/fax-name 0f
