light_mode unshaded;
blend_mode none;

// Brings the accumulated light map back into a sane range. Lights are drawn additively, so wherever
// several of them overlap the light map goes well above 1 and sprites get multiplied into a flat,
// washed out colour. This keeps everything below the knee as is and rolls the rest off smoothly.

uniform highp vec2 targetSize;
uniform highp float exposure;
uniform highp float knee;
uniform highp float maxLight;

highp float compress(highp float value)
{
    highp float range = max(maxLight - knee, 0.0001);
    return knee + range * (1.0 - exp(-(value - knee) / range));
}

void fragment()
{
    highp vec3 rgb = zTextureSpec(TEXTURE, FRAGCOORD.xy / targetSize).rgb * exposure;

    // Scale by the brightest channel so the hue of coloured lights survives the compression.
    highp float peak = max(rgb.r, max(rgb.g, rgb.b));
    if (peak > knee)
        rgb *= compress(peak) / peak;

    COLOR = vec4(rgb, 1.0);
}
