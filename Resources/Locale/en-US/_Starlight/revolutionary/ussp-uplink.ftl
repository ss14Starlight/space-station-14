ussp-uplink-implanted = Implanted! Current Telebonds: { $telebonds }{ $converted ->
    [0] {""}
   *[other] {" "}(+{ $converted } from previous conversions)
}, Conversions: { $conversions }
ussp-uplink-claimed = Your uplink has been claimed by { $name }
ussp-uplink-implanted-in = Your uplink has been implanted in { $name }
ussp-uplink-synchronized = Uplink synchronized! Current Telebonds: { $telebonds }, Conversions: { $conversions }
ussp-uplink-conversion = +1 Conversion (Total: { $total })
ussp-uplink-telebond = +1 Telebond (Total: { $total })
ussp-uplink-telebond-total-for = +1 Telebond (Total: { $total }) (for { $name })
ussp-uplink-telebond-for = +1 Telebond (for { $name })
