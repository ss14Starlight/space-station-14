cmd-nightshift-desc = Overrides the night shift lighting of every station, or of one station.
cmd-nightshift-help = Usage: nightshift <Auto|Day|Night> [station]
    Auto follows station time and events, Day and Night force the lighting until set back to Auto.
cmd-nightshift-hint-mode = <Auto|Day|Night>
cmd-nightshift-hint-station = [station]
cmd-nightshift-invalid-mode = "{ $mode }" is not a lighting mode, use Auto, Day or Night.
cmd-nightshift-invalid-station = "{ $station }" is not a station.
cmd-nightshift-success-all = Set the night shift of every station to { $mode }.
cmd-nightshift-success = Set the night shift of { $station } to { $mode }.
