command-description-layernetwork-list =
    List every entity in the entity's network of the specified type, restricted to the same layer only.
command-description-layernetwork-check =
    Report which entities would block moving the network to the given layer.
command-description-layernetwork-set =
    Move the piped entity's given network to the chosen layer. Returns entities that couldn't use the layer, if any.

command-arg-hint-layernetwork-list-group = <node group, e.g. Pipe or Plumbing>
command-arg-hint-layernetwork-check-group = <node group, e.g. Pipe or Plumbing>
command-arg-hint-layernetwork-check-layer = <target layer, e.g. Primary or Quaternary>
command-arg-hint-layernetwork-set-group = <node group, e.g. Pipe or Plumbing>
command-arg-hint-layernetwork-set-layer = <target layer, e.g. Primary or Quaternary>
