# Protective equipment
pathogen-protection-filter-mask = [color=yellow]Pathogen filter:[/color] partially filters inhaled pathogens without internals.
pathogen-protection-supply-mask = [color=yellow]Air-supply interface:[/color] protects from inhaled pathogens only while internals are working.
pathogen-protection-sterile-barrier = [color=yellow]Sterile barrier:[/color] reduces contact pathogen exposure.
pathogen-protection-bio-suit = [color=yellow]Bio suit:[/color] completely blocks contact pathogens and settling spores.
pathogen-protection-bio-hood = [color=yellow]Bio hood:[/color] completely seals the airway against pathogens.
pathogen-protection-sealed-suit = [color=yellow]Sealed outer suit:[/color] strongly reduces exposure to settling spores.
pathogen-protection-unknown = This item's pathogen protection cannot be identified.

