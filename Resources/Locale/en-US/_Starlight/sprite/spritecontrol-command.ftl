command-description-spritecontrol-setsource =
    Make the target mimic the provided entity's sprite.
command-description-spritecontrol-setplayer =
    Make the target mimic the provided player's sprite.
command-description-spritecontrol-setproto =
    Make the target mimic the provided entity prototype's sprite.
command-description-spritecontrol-setspecifier =
    Set the target's sprite to the provided sprite specifier.
command-description-spritecontrol-layerconf =
    Set layer settings for the target.
command-description-spritecontrol-transconf =
    Set transform settings for the target.
command-description-spritecontrol-reset =
    Restore the target's original sprite.
