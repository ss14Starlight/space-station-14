command-description-colorcontrol-color =
    Set the color of the target's sprite.
command-description-colorcontrol-shader =
    Set the shader of the target's sprite.
command-description-colorcontrol-targets =
    Set color targeting mode for the target's sprite.
command-description-colorcontrol-addlayer =
    Add a layer to the coloring filter.
command-description-colorcontrol-removelayer =
    Remove a layer from the coloring filter.
command-description-colorcontrol-clearlayers =
    Clears all coloring filter layers.
command-description-colorcontrol-overridelayer =
    Set color/shader override for a specific layer.
command-description-colorcontrol-clearoverrides =
    Removes all layer color/shader overrides.
command-description-colorcontrol-ignoreshader =
    Add a shader to the list of shaders that can't be modified.
command-description-colorcontrol-reset =
    Restore the target's original colors/shaders.
