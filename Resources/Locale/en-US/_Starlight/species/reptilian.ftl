## Thick scales

thick-scales-injector-blocked = {$injector} can't get through {THE($target)}'s thick scales!
thick-scales-syringe-slow = You struggle to push the needle between {THE($target)}'s scales...
thick-scales-remote-blocked-self = It bounces off your thick scales.
thick-scales-remote-blocked-attacker = It can't get through {THE($target)}'s thick scales!
thick-scales-examine = {CAPITALIZE(SUBJECT($target))} {CONJUGATE-HAVE($target)} [color=#8fbc8f]thick scales[/color] that a quick needle won't get through.

## Fire breath

fire-breath-too-hungry = You're too hungry to stoke a flame.
fire-breath-self = You breathe out a small puff of flame.
fire-breath-others = {CAPITALIZE(THE($user))} breathes out a small puff of flame!
fire-breath-fueled-self = The fuel in your stomach roars out as a gout of flame!
fire-breath-fueled-others = {CAPITALIZE(THE($user))} breathes out a gout of flame!
fire-breath-napalm-self = The napalm in your gut erupts as a roaring fireball!
fire-breath-napalm-others = {CAPITALIZE(THE($user))} spews a roaring napalm fireball!
fire-breath-light-self = You breathe a tiny flame onto {THE($target)}.
fire-breath-light-others = {CAPITALIZE(THE($user))} breathes a tiny flame onto {THE($target)}.
