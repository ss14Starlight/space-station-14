## Announcement sent when a launch is initiated

# {$beaconName} – name of the target beacon
# {$seconds}    – lead time in whole seconds
drop-pod-console-launch-announcement = ALERT: A Syndicate drop pod has been detected on an inbound trajectory targeting {$beaconName}. Brace for impact in {$seconds} seconds!

drop-pod-console-sender = Central Command
