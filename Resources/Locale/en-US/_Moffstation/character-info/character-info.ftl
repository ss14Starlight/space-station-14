character-info-name-format = [bold]{$name}[/bold]
character-info-job-format = [color=#A9A9A9]{$job}[/color]
character-info-details-format = {CAPITALIZE($gender)} • {$age} • {$species}
character-info-description-format = [color=#A9A9A9][italic]{$description}[/italic][/color]
character-info-description-truncated = {$description}...

character-info-role-type-format = [font size=16][bold][color={$color}]{$role}[/color][/bold][/font]
character-info-briefing-header = [bold]Briefing:[/bold]
character-info-objectives-header = [bold]Objectives:[/bold]
