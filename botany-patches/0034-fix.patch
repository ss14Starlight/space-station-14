@@ -121,7 +121,7 @@ private void OnPlantGrow(Entity<BasicGrowthComponent> ent, ref OnPlantGrowEvent
             }
             else
             {
-                AffectGrowth(uid, -1, holder);
+                AffectGrowth((uid, holder), -1);
                 holder.Health -= healthMod;
             }
 
