+                _appearance.SetData(uid, PlantHolderVisuals.HealthLight, component.Health <= traits.Endurance / 2f);
             }
 
             if (component.Dead)
@@ -611,10 +613,7 @@ public void UpdateSprite(EntityUid uid, PlantHolderComponent? component = null)
             }
             else
             {
-                if (spriteTraits == null)
-                    return;
-
