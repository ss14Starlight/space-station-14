From: Pok245 <113675512+Pok27@users.noreply.github.com>
Date: Mon, 2 Mar 2026 15:43:21 +0200
Subject: [PATCH 087/112] bug fixes

---
 Content.Shared/Botany/Systems/PlantHarvestSystem.cs | 5 +++++
 Content.Shared/Botany/Systems/PlantHolderSystem.cs  | 1 -
 Content.Shared/Botany/Systems/PlantSystem.cs        | 7 +++++++
 Content.Shared/Botany/Systems/PlantTraySystem.cs    | 2 +-
 4 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/Content.Shared/Botany/Systems/PlantHarvestSystem.cs b/Content.Shared/Botany/Systems/PlantHarvestSystem.cs
index 1c22f7c1f2..fd915a9067 100644
--- a/Content.Shared/Botany/Systems/PlantHarvestSystem.cs
+++ b/Content.Shared/Botany/Systems/PlantHarvestSystem.cs
@@ -33,6 +33,10 @@ private void OnPlantGrow(Entity<PlantHarvestComponent> ent, ref OnPlantGrowEvent
             || !TryComp<PlantComponent>(ent.Owner, out var plant))
             return;
 
+        // If the plant is not mature, set the last harvest to the current age.
+        if (holder.Age < plant.Maturation)
+            ent.Comp.LastHarvest = holder.Age;
+
         // Check if plant is ready for harvest.
         var timeLastHarvest = holder.Age - ent.Comp.LastHarvest;
         if (timeLastHarvest > plant.Production && !ent.Comp.ReadyForHarvest)
@@ -134,6 +138,7 @@ public void DoHarvest(Entity<PlantHarvestComponent> ent, Entity<PlantComponent>
 
         if (ent.Comp.HarvestRepeat == HarvestType.NoRepeat)
             _plant.RemovePlant(plantEnt.AsNullable());
+
         var ev = new AfterDoHarvestEvent(user, ent.Owner);
         RaiseLocalEvent(ent.Owner, ref ev);
     }
diff --git a/Content.Shared/Botany/Systems/PlantHolderSystem.cs b/Content.Shared/Botany/Systems/PlantHolderSystem.cs
index c6ad912e37..0e89a831b4 100644
--- a/Content.Shared/Botany/Systems/PlantHolderSystem.cs
+++ b/Content.Shared/Botany/Systems/PlantHolderSystem.cs
@@ -38,7 +38,6 @@ public void AdjustsMutationLevel(Entity<PlantHolderComponent?> ent, float amount
         ent.Comp.MutationLevel += amount * ent.Comp.MutationMod;
         ent.Comp.MutationLevel = MathHelper.Clamp(ent.Comp.MutationLevel, 0f, ent.Comp.MaxMutationLevel);
         DirtyField(ent, nameof(ent.Comp.MutationLevel));
-
         CheckHealth(ent);
     }
 
diff --git a/Content.Shared/Botany/Systems/PlantSystem.cs b/Content.Shared/Botany/Systems/PlantSystem.cs
index 83244425a9..51d3f08f81 100644
--- a/Content.Shared/Botany/Systems/PlantSystem.cs
+++ b/Content.Shared/Botany/Systems/PlantSystem.cs
@@ -99,6 +99,8 @@ public override void Update(float frameTime)
     {
         base.Update(frameTime);
 
+        // Protection against plant removal during update loop.
+        var toUpdate = new List<EntityUid>();
         var query = EntityQueryEnumerator<PlantHolderComponent>();
         while (query.MoveNext(out var uid, out var plantHolder))
         {
@@ -107,6 +109,11 @@ public override void Update(float frameTime)
 
             plantHolder.NextUpdate = _gameTiming.CurTime;
             DirtyField(uid, plantHolder, nameof(plantHolder.NextUpdate));
+            toUpdate.Add(uid);
+        }
+
+        foreach (var uid in toUpdate)
+        {
             Update(uid);
         }
     }
diff --git a/Content.Shared/Botany/Systems/PlantTraySystem.cs b/Content.Shared/Botany/Systems/PlantTraySystem.cs
index bc0aa35702..fe96124811 100644
--- a/Content.Shared/Botany/Systems/PlantTraySystem.cs
+++ b/Content.Shared/Botany/Systems/PlantTraySystem.cs
@@ -38,7 +38,7 @@ private void OnExamine(Entity<PlantTrayComponent> ent, ref ExaminedEvent args)
 
         using (args.PushGroup(nameof(PlantTrayComponent)))
         {
-            if (TryGetPlant(ent.AsNullable(), out var plantUid))
+            if (!TryGetPlant(ent.AsNullable(), out var plantUid))
                 args.PushMarkup(Loc.GetString("plant-holder-component-nothing-planted-message"));
 
             args.PushMarkup(GetTrayWarningsMarkup(ent.AsNullable()));
