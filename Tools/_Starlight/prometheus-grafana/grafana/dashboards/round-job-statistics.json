            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Species"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spawns"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "id": 7,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "desc": true,
            "displayName": "Spawns"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "topk(20, sum by (job_id, species_id) (max_over_time({App=\"Robust.Server\", Server=~`${Server:raw}`} |= \"sl_round_stat\" | logfmt | kind=\"job_spawn\" | round_id=~`${Round:raw}` | unwrap count [$__range])))",
          "legendFormat": "{{job_id}} / {{species_id}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Actual spawns by job and species",
      "type": "table",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "job_id": "Job",
              "species_id": "Species",
              "Value #A": "Spawns"
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Raw job preference, assignment and species spawn records for the selected server, rounds and time range.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{App=\"Robust.Server\", Server=~`${Server:raw}`} |= \"sl_round_stat\" | logfmt | kind=~\"job_.*\" | round_id=~`${Round:raw}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Raw job records",
      "type": "logs"
    }
  ],
