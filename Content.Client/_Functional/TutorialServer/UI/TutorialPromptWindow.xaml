<controls:TutorialPromptWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Functional.TutorialServer.UI"
    MinSize="360 300"
    SetSize="420 360">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <ScrollContainer Name="ContentScroll" VerticalExpand="True" HScrollEnabled="False" MinHeight="180">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                <RichTextLabel Name="GoalLabel" HorizontalExpand="True" MaxWidth="390" />
                <RichTextLabel Name="ChecklistLabel" HorizontalExpand="True" MaxWidth="390" />
                <RichTextLabel Name="StepLabel" HorizontalExpand="True" MaxWidth="390" />
                <RichTextLabel Name="StatusLabel" StyleClasses="LabelSubText" HorizontalExpand="True" MaxWidth="390" />
            </BoxContainer>
        </ScrollContainer>
        <Button Name="NextButton" Text="{Loc 'tutorial-server-prompt-next'}" HorizontalExpand="True" />
        <Button Name="HintButton" Text="{Loc 'tutorial-server-prompt-hint'}" HorizontalExpand="True" />
    </BoxContainer>
</controls:TutorialPromptWindow>
