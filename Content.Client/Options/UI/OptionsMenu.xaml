<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:stabs="clr-namespace:Content.Client._Starlight.Options.UI.Tabs"
            xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
            xmlns:sc="clr-namespace:Content.Client._Starlight.UserInterface.Controls"
            Title="{Loc 'ui-options-title'}"
            MinSize="800 450"
            SetSize="960 600">
    <!-- Starlight-start -->
    <sc:SectionNav Name="Sections" Access="Public" />
    <BoxContainer Name="Pages" Visible="False">
        <tabs:MiscTab Name="MiscTab" />
        <stabs:UITab Name="UITab" />
        <tabs:GraphicsTab Name="GraphicsTab" />
        <tabs:KeyRebindTab Name="KeyRebindTab" />
        <tabs:AudioTab Name="AudioTab" />
        <tabs:AccessibilityTab Name="AccessibilityTab" />
        <tabs:AdminOptionsTab Name="AdminOptionsTab" />
    </BoxContainer>
	<!-- Starlight-end -->
</DefaultWindow>
