<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <!--🌟Starlight🌟 start: sliders grouped into sections, more per-category volumes, scrollable-->
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <Label Text="{Loc 'ui-options-volume-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 8">
                    <ui:OptionSlider Name="SliderVolumeMaster" Title="{Loc 'ui-options-master-volume'}"
                                     Margin="0 0 0 8" />
                    <ui:OptionSlider Name="SliderVolumeInterface" Title="{Loc 'ui-options-interface-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeMidi" Title="{Loc 'ui-options-midi-volume'}" />
                </BoxContainer>

                <Label Text="{Loc 'ui-options-music-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 8">
                    <ui:OptionSlider Name="SliderVolumeAmbientMusic" Title="{Loc 'ui-options-ambient-music-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeLobby" Title="{Loc 'ui-options-lobby-volume'}" />
                </BoxContainer>

                <Label Text="{Loc 'ui-options-environment-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 8">
                    <ui:OptionSlider Name="SliderStationHum" Title="{Loc 'ui-options-station-hum-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeAmbience" Title="{Loc 'ui-options-machine-ambience-volume'}" />
                    <ui:OptionSlider Name="SliderEnvironment" Title="{Loc 'ui-options-environment-volume'}" />
                    <ui:OptionSlider Name="SliderMaxAmbienceSounds" Title="{Loc 'ui-options-ambience-max-sounds'}" />
                </BoxContainer>

                <Label Text="{Loc 'ui-options-world-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 8">
                    <ui:OptionSlider Name="SliderEffects" Title="{Loc 'ui-options-effects-volume'}" />
                    <ui:OptionSlider Name="SliderFootsteps" Title="{Loc 'ui-options-footsteps-volume'}" />
                    <ui:OptionSlider Name="SliderHandling" Title="{Loc 'ui-options-handling-volume'}" />
                    <ui:OptionSlider Name="SliderCombat" Title="{Loc 'ui-options-combat-volume'}" />
                </BoxContainer>

                <Label Text="{Loc 'ui-options-voices-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 8">
                    <ui:OptionSlider Name="SliderVoice" Title="{Loc 'ui-options-voice-volume'}" />
                    <ui:OptionSlider Name="SliderAnnouncement" Title="{Loc 'ui-options-announcement-volume'}" />
                </BoxContainer>

                <Label Text="{Loc 'ui-options-tts-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 8">
                    <CheckBox Name="TtsClientCheckBox" Text="{Loc 'ui-options-tts-enabled'}" />
                    <CheckBox Name="TtsRadioQueueCheckBox" Text="{Loc 'ui-options-tts-radio-queue-enabled'}" />
                    <ui:OptionSlider Name="SliderTts" Title="{Loc 'ui-options-tts-volume'}" />
                    <ui:OptionSlider Name="SliderTtsRadio" Title="{Loc 'ui-options-tts-radio-volume'}" />
                    <ui:OptionSlider Name="SliderTtsAnnounce" Title="{Loc 'ui-options-tts-announce-volume'}"/>
                    <ui:OptionSlider Name="SliderTtsChime" Title="{Loc 'ui-options-tts-chime-volume'}" />
                </BoxContainer>

                <Label Text="{Loc 'ui-options-sound-toggles-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical" Margin="0 3 0 0">
                    <CheckBox Name="LobbyMusicCheckBox" Text="{Loc 'ui-options-lobby-music'}" />
                    <CheckBox Name="RestartSoundsCheckBox" Text="{Loc 'ui-options-restart-sounds'}" />
                    <CheckBox Name="EventMusicCheckBox" Text="{Loc 'ui-options-event-music'}" />
                    <CheckBox Name="AdminSoundsCheckBox" Text="{Loc 'ui-options-admin-sounds'}" />
                    <CheckBox Name="BwoinkSoundCheckBox" Text="{Loc 'ui-options-bwoink-sound'}" />
                    <CheckBox Name="RadioChimeMuteCheckBox" Text="{Loc 'ui-options-radio-chime-mute'}" />
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>
        <!--🌟Starlight🌟 end-->
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
