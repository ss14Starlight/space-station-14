<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="clr-namespace:Content.Client.Options.UI"
         xmlns:sui="clr-namespace:Content.Client._Starlight.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <!-- Starlight-start -->
            <BoxContainer Orientation="Vertical" Margin="0 0 8 8">
                <VBox Name="AdminToolsContainer">
	                <Label Text="{Loc 'ui-options-admin-tools'}" StyleClasses="LabelKeyText" Margin="0 0 0 4"/>
	                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
		                <!-- Options here are generated and controlled via flags -->
		                <VBox Orientation="Vertical" Margin="10 6" SeparationOverride="4" Name="AdminToolOptsContainer"/>
	                </PanelContainer>
                </VBox>

                <Label Text="{Loc 'ui-options-admin-ghost-hud'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <sui:OptionDropDown Name="DropDownAGhostJobIconSetting" Title="{Loc 'ui-options-admin-ghost-hud-setting-job'}" />
                        <sui:OptionDropDown Name="DropDownAGhostHealthIconSetting" Title="{Loc 'ui-options-admin-ghost-hud-setting-health'}" />
                        <CheckBox Name="EnableAGhostCriminalRecordIcons" Text="{Loc 'ui-options-admin-ghost-hud-show-criminal-record-icons'}" />
                        <CheckBox Name="EnableAGhostFactionIcons" Text="{Loc 'ui-options-admin-ghost-hud-show-faction-icons'}" />
                        <CheckBox Name="EnableAGhostSatiationIcons" Text="{Loc 'ui-options-admin-ghost-hud-show-satiation-icons'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-admin-player-panel'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <sui:OptionDropDown Name="DropDownPlayerTabSymbolSetting" Title="{Loc 'ui-options-admin-player-tab-symbol-setting'}" />
                        <sui:OptionDropDown Name="DropDownPlayerTabRoleSetting" Title="{Loc 'ui-options-admin-player-tab-role-setting'}" />
                        <sui:OptionDropDown Name="DropDownPlayerTabColorSetting" Title="{Loc 'ui-options-admin-player-tab-color-setting'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-admin-ahelp-label'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6">
                        <sui:BarLayoutEditor Name="AHelpLayoutEditor" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-admin-overlay-title'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <sui:OptionDropDown Name="DropDownOverlayAntagFormat" Title="{Loc 'ui-options-admin-overlay-antag-format'}" />
                        <sui:OptionDropDown Name="DropDownOverlayAntagSymbol" Title="{Loc 'ui-options-admin-overlay-antag-symbol'}" />
                        <CheckBox Name="EnableOverlayPlaytimeCheckBox" Text="{Loc 'ui-options-admin-enable-overlay-playtime'}" />
                        <CheckBox Name="EnableOverlayStartingJobCheckBox" Text="{Loc 'ui-options-admin-enable-overlay-starting-job'}" />
                        <sui:OptionSlider Name="OverlayMergeDistanceSlider" Title="{Loc 'ui-options-admin-overlay-merge-distance'}" />
                        <sui:OptionSlider Name="OverlayGhostFadeSlider" Title="{Loc 'ui-options-admin-overlay-ghost-fade-distance'}" />
                        <sui:OptionSlider Name="OverlayGhostHideSlider" Title="{Loc 'ui-options-admin-overlay-ghost-hide-distance'}" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <!-- Starlight-end -->
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
