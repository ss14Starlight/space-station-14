<tabs:MiscTab xmlns="https://spacestation14.io"
              xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <!-- Starlight-start: options grouped in cards -->
            <BoxContainer Orientation="Vertical" Margin="0 0 8 8">
                <Label Text="{Loc 'ui-starlight'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <CheckBox Name="AutoPunctuate" Text="{Loc 'ui-options-auto-punctuate'}" />
                        <CheckBox Name="WieldBeforeRack" Text="{Loc 'ui-options-wield-before-rack'}" ToolTip="{Loc 'ui-options-wield-before-rack-tooltip'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-general-speech'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <CheckBox Name="ShowOocPatronColor" Text="{Loc 'ui-options-show-ooc-patron-color'}" />
                        <CheckBox Name="ShowLoocAboveHeadCheckBox" Text="{Loc 'ui-options-show-looc-on-head'}" />
                        <CheckBox Name="FancySpeechBubblesCheckBox" Text="{Loc 'ui-options-fancy-speech'}" />
                        <CheckBox Name="FancyNameBackgroundsCheckBox" Text="{Loc 'ui-options-fancy-name-background'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-general-cursor'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <!-- Starlight-edit: ShowHeldItemCheckBox moved to the sight settings in the UI tab -->
                        <CheckBox Name="ShowCombatModeIndicatorsCheckBox" Text="{Loc 'ui-options-show-combat-mode-indicators'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-general-storage'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <CheckBox Name="OpaqueStorageWindowCheckBox" Text="{Loc 'ui-options-opaque-storage-window'}" />
                        <CheckBox Name="StaticStorageUI" Text="{Loc 'ui-options-static-storage-ui'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-general-discord'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel" Margin="0 0 0 12">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <CheckBox Name="DiscordRich" Text="{Loc 'ui-options-discordrich'}" />
                    </BoxContainer>
                </PanelContainer>

                <Label Text="{Loc 'ui-options-general-ghost-themes'}" StyleClasses="LabelKeyText" Margin="0 0 0 4" />
                <PanelContainer StyleClasses="InsetPanel">
                    <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                        <CheckBox Name="ForceTestersTab" Text="{Loc 'ui-options-general-ghost-themes-force-tester'}" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
			<!-- Starlight-end -->
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:MiscTab>
