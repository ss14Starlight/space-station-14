<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    MinSize="620 670"
    Title="Material dispenser">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5" SeparationOverride="10">
        <!-- Crate container info -->
        <BoxContainer Orientation="Horizontal">
            <Label Text="Crate input" />
            <Control HorizontalExpand="True" />
            <OptionButton Access="Public" Name="DepartmentSelector" />
            <Button Access="Public" Name="EjectCrate" Text="Eject crate" ToolTip="Creates crate with the material blow. Requires 5 Steel to be in the buffer to create crate" />
        </BoxContainer>
        <!-- Crate input info -->
        <PanelContainer VerticalExpand="True" MinSize="0 200">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer HorizontalExpand="True" MinSize="0 200">
                <BoxContainer Name="OutputCrateInfo" Orientation="Vertical">
                    <Label Name="NoMatsInCrate" Text="Crate is currently empty"></Label>
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
        <Control MinSize="0 10" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="Stored materials"></Label>
            <Control HorizontalExpand="True" />
            <Button MinSize="80 0" Name="StorageTransferButton" Access="Public" Text="Transfer" ToggleMode="True" StyleClasses="OpenRight" />
            <Button MinSize="80 0" Name="StorageEjectButton" Access="Public" Text="Eject" ToggleMode="True" StyleClasses="OpenLeft" />
        </BoxContainer>
        <!-- MaterialStorage info -->
        <PanelContainer VerticalExpand="True" MinSize="0 200">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <BoxContainer Name="BufferInfo" Orientation="Vertical">

            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
