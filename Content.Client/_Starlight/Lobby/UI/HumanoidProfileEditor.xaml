<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
    xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
    xmlns:ui1="clr-namespace:Content.Client._Starlight.Lobby.UI"
    xmlns:traits="clr-namespace:Content.Client._Starlight.Traits.UI"
    xmlns:starlightHumanoid="clr-namespace:Content.Client._Starlight.Humanoid"
    xmlns:antags="clr-namespace:Content.Client._Moffstation.Antags.UI"
    xmlns:sc="clr-namespace:Content.Client._Starlight.UserInterface.Controls"
    HorizontalExpand="True">
    <!--  Left side  -->
    <BoxContainer Margin="8" HorizontalExpand="True" Orientation="Vertical" SeparationOverride="8">
        <!--  Name and profile actions, one row  -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'humanoid-profile-editor-name-label'}" VAlign="Center" />
            <LineEdit Name="NameEdit" HorizontalExpand="True" MinWidth="180" />
            <Button Name="NameRandomize" Text="{Loc 'humanoid-profile-editor-name-random-button'}" />
            <Label Name="NameRulesHint" Text="(?)" StyleClasses="LabelSubText" VAlign="Center" MouseFilter="Stop" />
            <Control MinWidth="12" />
            <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}" />
            <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}" />
            <sc:DropdownButton Name="MoreButton" Text="•••" />
        </BoxContainer>
        <!--  Moved into MoreButton on load  -->
        <BoxContainer Name="MoreActions" Orientation="Vertical">
            <Button Name="RandomizeEverythingButton" Text="{Loc 'humanoid-profile-editor-randomize-everything-button'}" />
            <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" />
            <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" />
            <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" />
            <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
        </BoxContainer>
        <!--  Moved into the body tab on load  -->
        <BoxContainer Name="SpeciesSection" Orientation="Vertical" VerticalExpand="True" SeparationOverride="6">
            <BoxContainer Name="CSubspecies" Orientation="Horizontal" SeparationOverride="8">
                <Label Text="{Loc 'humanoid-profile-editor-subspecies-label'}" VAlign="Center" />
                <OptionButton Name="SubspeciesButton" HorizontalExpand="True" />
            </BoxContainer>
            <PanelContainer StyleClasses="InsetPanel" VerticalExpand="True">
                <ui1:SpeciesPicker Name="SpeciesButton" />
            </PanelContainer>
        </BoxContainer>
        <ScrollContainer Name="CyberneticsSection" VerticalExpand="True" HScrollEnabled="False">
            <starlightHumanoid:CyberneticsPicker Name="Cybernetics" />
        </ScrollContainer>
        <TabContainer Name="TabContainer" VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                    <BoxContainer Name="CCustomSpecieName" Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-customspeciename-label'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <LineEdit Name="CCustomSpecieNameEdit" MinWidth="200" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-age-label'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <LineEdit Name="AgeEdit" MinWidth="80" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <sc:SegmentedButtons Name="SexButton" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <sc:SegmentedButtons Name="PronounsButton" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <sc:SegmentedButtons Name="SpawnPriorityButton" />
                    </BoxContainer>
                    <BoxContainer Name="CSpeciesLoadout" Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-species-loadout'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <Button Name="SpeciesLoadout" Text="{Loc 'humanoid-profile-editor-species-loadout-select'}" />
                    </BoxContainer>
                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-height'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <Slider Name="HeightSlider" HorizontalExpand="True" MaxValue="1.5" MinValue="0.5" Value="1" />
                        <LineEdit Name="HeightEdit" SetWidth="56" />
                        <Label Text="{Loc 'humanoid-profile-editor-height-unit'}" StyleClasses="LabelSubText" VAlign="Center" SetWidth="24" />
                        <Button Name="HeightResetButton" Text="{Loc 'humanoid-profile-editor-slider-reset'}" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'humanoid-profile-editor-weight'}" SetWidth="190" VAlign="Center" ClipText="True" />
                        <Slider Name="WidthSlider" HorizontalExpand="True" MaxValue="1.5" MinValue="0.5" Value="1" />
                        <LineEdit Name="WeightEdit" SetWidth="56" />
                        <Label Text="{Loc 'humanoid-profile-editor-weight-unit'}" StyleClasses="LabelSubText" VAlign="Center" SetWidth="24" />
                        <Button Name="WidthResetButton" Text="{Loc 'humanoid-profile-editor-slider-reset'}" />
                    </BoxContainer>
                </BoxContainer>
            </ScrollContainer>
            <!--  Jobs, laid out like the antags and traits tabs  -->
            <BoxContainer Orientation="Vertical" Margin="0 4 0 0">
                <PanelContainer StyleClasses="TraitsHeaderPanel" Margin="0 0 0 8">
                    <BoxContainer Orientation="Horizontal" Margin="12 10">
                        <Label Text="{Loc 'humanoid-profile-editor-jobs-tab'}" StyleClasses="TraitsTitleLabel" />
                        <Control HorizontalExpand="True" />
                        <Label Name="JobCountLabel" StyleClasses="TraitsStatLabel" />
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="TraitsSearchBar" Margin="0 0 0 8">
                    <LineEdit Name="JobSearch" PlaceHolder="{Loc 'job-tab-search'}" HorizontalExpand="True"
                              StyleClasses="TraitsSearchInput" Margin="10 8" />
                </PanelContainer>
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="JobList" Orientation="Vertical" Margin="0 0 4 0" />
                </ScrollContainer>
            </BoxContainer>
            <!--  Starlight: loadouts of every role, edited in place  -->
            <ui1:LoadoutTab Name="LoadoutTab" />
            <!--  Starlight - Start  -->
            <antags:SpecialRolesTab Name="Antags" /> <!-- Moffstation -->
            <!-- <BoxContainer Margin="10" Orientation="Vertical"> -->
                <!--  Antags  -->
                <!-- <ScrollContainer VerticalExpand="True"> -->
                    <!-- <BoxContainer Name="AntagList" Orientation="Vertical" /> -->
                <!-- </ScrollContainer> -->
            <!-- </BoxContainer> -->
            <!-- <BoxContainer Orientation="Vertical" Margin="10"> -->
            <!--  Traits  -->
            <!-- <ScrollContainer VerticalExpand="True"> -->
            <!-- <BoxContainer Name="TraitsList" Orientation="Vertical" /> -->
            <!-- </ScrollContainer>
                </BoxContainer>-->
            <traits:TraitsTab Name="Traits" />
            <!--  Starlight - End  -->
            <!--  Starlight: markings, hair, skin and eyes, part by part  -->
            <ui1:BodyTab Name="BodyTab" />
            <!--  Starlight: text-to-speech voices, picked in place instead of in a window  -->
            <BoxContainer Name="VoiceTab" Orientation="Vertical" Margin="0 4 0 0">
                <PanelContainer StyleClasses="TraitsHeaderPanel" Margin="0 0 0 8">
                    <BoxContainer Orientation="Horizontal" Margin="12 10" SeparationOverride="8">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                            <Label Text="{Loc 'humanoid-profile-editor-voice-tab'}" StyleClasses="TraitsTitleLabel" />
                            <Label Name="CurrentVoiceLabel" StyleClasses="TraitsSubtitleLabel" />
                        </BoxContainer>
                        <sc:SegmentedButtons Name="VoiceKindButton" VerticalAlignment="Center" />
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Name="VoicePickerSlot" Orientation="Vertical" VerticalExpand="True" />
            </BoxContainer>
            <!--  Starlight start  -->
            <BoxContainer Name="ICInfoTab" Orientation="Vertical" Margin="0 4 0 0" Visible="False">
                <ui1:CharacterInfoEditor Name="ICInfoEditor" />
            </BoxContainer>
            <BoxContainer Name="OOCInfoTab" Orientation="Vertical" Margin="0 4 0 0" Visible="False">
                <ui1:OOCInfoEditor Name="OOCInfoEditor" />
            </BoxContainer>
            <!--  Starlight end  -->
        </TabContainer>
    </BoxContainer>
    <!--  Right side  -->
    <BoxContainer Name="PreviewPanel" Orientation="Vertical" VerticalExpand="True" VerticalAlignment="Center">
        <CheckBox Name="ShowClothes" Text="{Loc 'humanoid-profile-editor-clothing'}" Pressed="True" HorizontalAlignment="Center" />
        <profile:ProfilePreviewSpriteView Name="SpriteView" Scale="8 8" Margin="4" SizeFlagsStretchRatio="1" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5">
            <Button Name="SpriteRotateLeft" Text="◀" StyleClasses="OpenRight" />
            <cc:VSeparator Margin="2 0 3 0" />
            <Button Name="SpriteRotateRight" Text="▶" StyleClasses="OpenLeft" />
        </BoxContainer>
    </BoxContainer>
</BoxContainer>
