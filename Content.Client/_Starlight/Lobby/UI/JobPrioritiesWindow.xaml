<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'job-priorities-window-title'}"
               SetSize="900 640"
               MinSize="640 420">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Name="SummaryLabel" StyleClasses="LabelSubText" HorizontalExpand="True" VAlign="Center" ClipText="True" />
            <LineEdit Name="SearchLineEdit" MinWidth="220" PlaceHolder="{Loc 'job-priorities-window-search'}" />
        </BoxContainer>
        <GridContainer Name="FilterGrid" Columns="7" HSeparationOverride="4" VSeparationOverride="4" />
        <PanelContainer StyleClasses="InsetPanel" VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <GridContainer Name="DepartmentGrid" Columns="2" HSeparationOverride="16" VSeparationOverride="12" Margin="10" />
            </ScrollContainer>
        </PanelContainer>
        <Label Text="{Loc 'job-priorities-window-hint'}" StyleClasses="LabelSubText" />
    </BoxContainer>
</DefaultWindow>
