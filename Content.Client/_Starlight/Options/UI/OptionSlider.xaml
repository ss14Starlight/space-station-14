<Control xmlns="https://spacestation14.io">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Name="NameLabel" HorizontalExpand="True" VAlign="Center" />
            <Slider Name="Slider" Access="Public" MinWidth="240" VerticalAlignment="Center" />
            <Label Name="ValueLabel" Access="Public" Margin="8 0 4 0" MinWidth="48" Align="Right" />
        </BoxContainer>
        <RichTextLabel Name="DescriptionLabel" StyleClasses="LabelSubText" Visible="False" />
    </BoxContainer>
</Control>
