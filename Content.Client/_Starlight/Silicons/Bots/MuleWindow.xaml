<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="360 380"
                      SetSize="360 380">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <PanelContainer StyleClasses="InsetPanel">
            <BoxContainer Orientation="Vertical" Margin="8 6">
                <Label Name="StatusLabel" StyleClasses="LabelHeading" />
                <Label Name="LoadLabel" />
                <Label Name="ChargeLabel" />
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="PowerButton" ToggleMode="True" Text="{Loc 'mule-window-power'}" HorizontalExpand="True" />
            <Button Name="UnloadButton" Text="{Loc 'mule-window-unload'}" HorizontalExpand="True" />
        </BoxContainer>

        <GridContainer Columns="2" HSeparationOverride="8">
            <Label Text="{Loc 'mule-window-destination'}" StyleClasses="LabelWeak" MinWidth="90" />
            <OptionButton Name="DestinationOption" HorizontalExpand="True" />
            <Label Text="{Loc 'mule-window-home'}" StyleClasses="LabelWeak" MinWidth="90" />
            <OptionButton Name="HomeOption" HorizontalExpand="True" />
        </GridContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="GoButton" Text="{Loc 'mule-window-go'}" HorizontalExpand="True" />
            <Button Name="StopButton" Text="{Loc 'mule-window-stop'}" HorizontalExpand="True" />
            <Button Name="HomeButton" Text="{Loc 'mule-window-return'}" HorizontalExpand="True" />
        </BoxContainer>

        <BoxContainer Orientation="Vertical">
            <CheckBox Name="AutoReturnBox" Text="{Loc 'mule-window-auto-return'}" />
            <CheckBox Name="AutoPickupBox" Text="{Loc 'mule-window-auto-pickup'}" />
            <CheckBox Name="ReportBox" Text="{Loc 'mule-window-report'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
