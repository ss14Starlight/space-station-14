<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'devil-damnations-ui-menu-title'}"
                      MinSize="200 100"
                      SetSize="500 600">
    <BoxContainer Orientation="Vertical"
                  VerticalExpand="True"
                  Margin="10 10 10 10">
        <TabContainer Name="DamnationCategories" VerticalExpand="True">
            <BoxContainer Name="DamnationsInfoBox"
                          Orientation="Vertical"
                          VerticalExpand="True">
                <ScrollContainer HScrollEnabled="False"
                                 VerticalExpand="True"
                                 Margin="10 10 10 10">
                    <BoxContainer Orientation="Vertical">
                        <RichTextLabel Text="{Loc 'devil-damnations-ui-menu-text'}"
                                       VerticalAlignment="Top"/>
                        <Control MinHeight="10"/>
                        <Label Text="{Loc 'devil-damnations-ui-damned-crew'}"
                               StyleClasses="LabelBig"/>
                        <BoxContainer Name="DamnedCrewList"
                                      Orientation="Horizontal"
                                      VerticalExpand="True"
                                      Margin="5 5 5 5">
                        </BoxContainer>
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
