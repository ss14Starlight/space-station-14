<controls:StaffHelpWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Starlight.MHelp.UI"
    Title="{Loc 'staff-help-title'}">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Text="{Loc 'staff-help-admin-hint'}" />
        <Button Name="AdminHelpButton" Access="Public" Text="{Loc 'staff-help-admin'}" StyleClasses="OpenBoth" />
        <RichTextLabel Text="{Loc 'staff-help-mentor-hint'}" Margin="0 20 0 0" />
        <Button Name="MentorHelpButton" Access="Public" Text="{Loc 'staff-help-mentor'}" StyleClasses="OpenBoth" />
    </BoxContainer>
</controls:StaffHelpWindow>
