<Control xmlns="https://spacestation14.io"
         xmlns:co="clr-namespace:Content.Client.UserInterface.Controls"
         Margin="4">
    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
    <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True">
        <Label Name="SummaryLabel"
               Text="{Loc administration-ui-events-tab-loading}" />

        <!-- Everything sits inside one scroll: with the window made short the sections used
             to be cut off entirely rather than shrink, leaving the catalogue unreachable.
             Active and upcoming size to their content, so a single active event leaves no
             empty block behind and a full queue is not squeezed into a scrollbar while the
             tab has room to spare. Overflow is the outer scroll's job, not theirs. Each
             section folds from its header, so an admin who only cares about one can give it
             the whole tab. -->

        <BoxContainer Name="ActiveSection"
                      Orientation="Vertical"
                      SeparationOverride="2">
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ActiveToggleButton"
                        MinWidth="26"
                        ToolTip="{Loc administration-ui-events-tab-collapse-tooltip}" />
                <Label Text="{Loc administration-ui-events-tab-active-title}"
                       FontColorOverride="#FFCA72"
                       VerticalAlignment="Center" />
                <Label Name="ActiveStatusLabel"
                       Text="{Loc administration-ui-events-tab-loading}"
                       VerticalAlignment="Center" />
            </BoxContainer>
            <ScrollContainer Name="ActiveScroll"
                             Margin="0 0 12 0"
                             HScrollEnabled="False"
                             ReturnMeasure="True">
                <BoxContainer Name="ActiveList"
                              Orientation="Vertical"
                              SeparationOverride="3" />
            </ScrollContainer>
        </BoxContainer>

        <BoxContainer Name="QueueSection"
                      Orientation="Vertical"
                      SeparationOverride="2">
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="QueueToggleButton"
                        MinWidth="26"
                        ToolTip="{Loc administration-ui-events-tab-collapse-tooltip}" />
                <Label Text="{Loc administration-ui-events-tab-queue-title}"
                       FontColorOverride="#8FD3FF"
                       VerticalAlignment="Center" />
                <Label Name="QueueStatusLabel"
                       Text="{Loc administration-ui-events-tab-loading}"
                       VerticalAlignment="Center" />
            </BoxContainer>
            <ScrollContainer Name="QueueScroll"
                             Margin="0 0 12 0"
                             HScrollEnabled="False"
                             ReturnMeasure="True">
                <BoxContainer Name="QueueList"
                              Orientation="Vertical"
                              SeparationOverride="3" />
            </ScrollContainer>
        </BoxContainer>

        <BoxContainer Name="CatalogSection"
                      Orientation="Vertical"
                      SeparationOverride="2">
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="CatalogToggleButton"
                        MinWidth="26"
                        ToolTip="{Loc administration-ui-events-tab-collapse-tooltip}" />
                <Label Text="{Loc administration-ui-events-tab-catalog-title}"
                       FontColorOverride="#B8E986"
                       VerticalAlignment="Center" />
            </BoxContainer>
            <BoxContainer Name="CatalogBody" Orientation="Vertical" SeparationOverride="3">
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Text="{Loc administration-ui-events-tab-search-label}"
                           VerticalAlignment="Center" />
                    <LineEdit Name="SearchLineEdit"
                              HorizontalExpand="True"
                              PlaceHolder="{Loc administration-ui-events-tab-filter-placeholder}" />
                    <Label Text="{Loc administration-ui-events-tab-sort-label}"
                           VerticalAlignment="Center" />
                    <OptionButton Name="SortOptionButton"
                                  MinWidth="170" />
                    <Button Name="SortDirectionButton"
                            MinWidth="90" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Control HorizontalExpand="True" />
                    <Button Name="AvailableOnlyButton"
                            Text="{Loc administration-ui-events-tab-available-only}"
                            ToggleMode="True" />
                    <Button Name="RefreshButton"
                            Text="{Loc administration-ui-events-tab-refresh}" />
                </BoxContainer>
                <co:SearchListContainer Name="SearchList" Access="Public" MinHeight="260" Margin="0 0 12 0" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
    </ScrollContainer>
</Control>
