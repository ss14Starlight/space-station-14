<BoxContainer Orientation="Vertical"
              xmlns="https://spacestation14.io"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              SeparationOverride="8">
    <PanelContainer StyleClasses="SpritePreview" HorizontalAlignment="Center">
        <TextureRect Name="PreviewImage" Access="Public" TextureScale="4 4" Stretch="KeepCentered" MinSize="160 160" />
    </PanelContainer>
    <Label Name="ThemeNameLabel" Access="Public" HorizontalAlignment="Center" StyleClasses="LabelHeading" />
    <RichTextLabel Name="ThemeDescriptionLabel" Access="Public" />
    <Label Name="RgbSkinColorLabel" Text="{Loc 'humanoid-profile-editor-skin-color-label'}" StyleClasses="LabelKeyText" />
    <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True" />
    <Button Name="SelectButton" Text="{Loc 'ghost-gui-choose-theme'}" HorizontalExpand="True" StyleClasses="positive" Margin="0 4 0 0" />
</BoxContainer>
