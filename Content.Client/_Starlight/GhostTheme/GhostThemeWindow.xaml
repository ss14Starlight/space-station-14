<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    Title="{Loc 'ghost-gui-ghost-theme-window-title'}"
    MinSize="900 560"
    SetSize="900 560">
    <SplitContainer State="Auto" VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
	        <LineEdit Name="Search" VerticalAlignment="Top" Margin="0 0 0 8" PlaceHolder="{Loc 'crayon-window-placeholder'}"/>
            <TabContainer Name="CategoryTabs" Margin="0 0 0 8" VerticalExpand="True">
            </TabContainer>
        </BoxContainer>
        <ScrollContainer VerticalExpand="True" HorizontalExpand ="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Name="GhostThemeDescriptionContainer" VerticalExpand="True"/>
        </ScrollContainer>
    </SplitContainer>
</DefaultWindow>
