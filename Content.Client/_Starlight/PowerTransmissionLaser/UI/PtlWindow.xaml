<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               MinSize="320 190" Title="{Loc ptl-ui-title}">

    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
            <Button Name="EnabledButton" Access="Public" Text="{Loc ptl-ui-start}" />
            <Control HorizontalExpand="True" />
            <Label Name="TotalSpesosLabel" Access="Public" Text="{Loc ptl-ui-total-spesos}" />
        </BoxContainer>

        <BoxContainer Orientation="Vertical" SeparationOverride="4">
            <Label Name="BatteryLabel" Access="Public" Text="{Loc ptl-ui-battery}" />
        </BoxContainer>

        <BoxContainer Orientation="Vertical" SeparationOverride="4">
            <Label Name="PowerLabel" Access="Public" Text="{Loc ptl-ui-power}" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
                <LineEdit Name="PowerLineEdit" Access="Public" MinSize="90 0" />
                <Label Text="MW" />
                <Control HorizontalExpand="True" />
                <Button Name="ApplyPowerButton" Access="Public" Text="{Loc ptl-ui-apply}" />
            </BoxContainer>
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
