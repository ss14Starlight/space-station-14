<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:style="clr-namespace:Content.Client.Stylesheets"
                     Title="{Loc 'genetics-console-window-title'}"
                     >
    <BoxContainer Name="Main" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="5 5 5 5" MinWidth="1300" MinHeight="700">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True">
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center">
                <BoxContainer HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Label Text="Trait Info"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center">
                <BoxContainer HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Label Text="Gene Info"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center">
                <BoxContainer HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Label Text="Genes"/>
                    <ScrollContainer Name="GenesContainer" VerticalExpand="True">
                        <ItemList Name="GenesItemList"/>
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center">
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalExpand="True">
                    <Button Text="-&gt;"/>
                    <Button Text="&lt;-"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center">
                <BoxContainer HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Label Text="Genome"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center">
                <BoxContainer VerticalAlignment="Top">
                    <Label Text="Result"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Stretch" SeparationOverride="5">
            <Button Text="Print Genetic Sampler" HorizontalExpand="True"/>
            <Button Text="Print Genetic Applicator" HorizontalExpand="True"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
