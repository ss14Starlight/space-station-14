<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'medipen-refiller-window-title'}"
                      MinSize="320 160"
                      SetSize="420 220">
    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="5">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Label Name="NoJugsLabel" Text="{Loc 'medipen-refiller-window-no-jugs'}" />
            <GridContainer Name="JugList" HorizontalExpand="True" Columns="2" />
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
