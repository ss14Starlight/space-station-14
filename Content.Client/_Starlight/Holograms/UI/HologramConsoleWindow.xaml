<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:ui="clr-namespace:Content.Client._Starlight.Holograms.UI"
               Title="{Loc 'hologram-console-window-title'}"
               Resizable="False"
               MinSize="1400 850"
               SetSize="1400 850">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <!-- Header -->
        <PanelContainer StyleClasses="AngleRect">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#0a0e27"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" Margin="12">
                <BoxContainer Orientation="Vertical">
                    <Label Text="HOLOGRAM PROJECTION SYSTEM" 
                           StyleClasses="LabelBig"
                           Margin="0 0 0 4">
                        <Label.FontColorOverride>#00d9ff</Label.FontColorOverride>
                    </Label>
                    <Label Name="StatusLabel" 
                           Text="System Ready"
                           StyleClasses="LabelSmall">
                        <Label.FontColorOverride>#7dd3fc</Label.FontColorOverride>
                    </Label>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <Label Name="ActiveIndicator"
                           Text="● INACTIVE"
                           Margin="0 0 0 2">
                        <Label.FontColorOverride>#6b7280</Label.FontColorOverride>
                    </Label>
                    <Label Name="ModeLabel"
                           Text=""
                           StyleClasses="LabelSmall"
                           Visible="False">
                        <Label.FontColorOverride>#fbbf24</Label.FontColorOverride>
                    </Label>
                </BoxContainer>
                <!-- Battery Status -->
                <PanelContainer Name="BatteryPanel" Visible="False" StyleClasses="AngleRect" Margin="8 0 0 0" MinSize="120 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1e293b" BorderColor="#374151" BorderThickness="1 1 1 1"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Horizontal" Margin="6 4" SeparationOverride="4" VerticalAlignment="Center">
                        <!-- Battery Icon -->
                        <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
                            <PanelContainer MinSize="2 12" MaxSize="2 12">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#6b7280"/>
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <PanelContainer MinSize="28 16" MaxSize="28 16">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#1e293b" BorderColor="#6b7280" BorderThickness="1 1 1 1"/>
                                </PanelContainer.PanelOverride>
                                <ProgressBar Name="BatteryBar" Value="1.0" MinHeight="14" Margin="1" VerticalAlignment="Stretch">
                                    <ProgressBar.ForegroundStyleBoxOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#10b981"/>
                                    </ProgressBar.ForegroundStyleBoxOverride>
                                    <ProgressBar.BackgroundStyleBoxOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#00000000"/>
                                    </ProgressBar.BackgroundStyleBoxOverride>
                                </ProgressBar>
                            </PanelContainer>
                        </BoxContainer>
                        <Label Name="BatteryLabel" Text="100%" StyleClasses="LabelSmall" MinSize="35 0">
                            <Label.FontColorOverride>#10b981</Label.FontColorOverride>
                        </Label>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Main Content -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <!-- Left Panel - Disks -->
            <BoxContainer Orientation="Vertical" SetWidth="340" SeparationOverride="6">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="HOLOGRAM DATABASE" StyleClasses="LabelHeading">
                        <Label.FontColorOverride>#a78bfa</Label.FontColorOverride>
                    </Label>
                    <Label Name="DiskCountLabel" Text="0 / 8" StyleClasses="LabelSmall">
                        <Label.FontColorOverride>#9ca3af</Label.FontColorOverride>
                    </Label>
                </BoxContainer>
                
                <PanelContainer SetHeight="580" StyleClasses="AngleRect">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#111827"/>
                    </PanelContainer.PanelOverride>
                    <ScrollContainer>
                        <BoxContainer Name="DisksList" Orientation="Vertical" Margin="6" SeparationOverride="4"/>
                    </ScrollContainer>
                </PanelContainer>

                <!-- Settings -->
                <PanelContainer Name="SettingsPanel" Visible="False" StyleClasses="AngleRect">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1e293b"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                        <Label Text="PORTABLE SETTINGS" StyleClasses="LabelSmall">
                            <Label.FontColorOverride>#fbbf24</Label.FontColorOverride>
                        </Label>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="Allow Hologram Carry" VerticalAlignment="Center">
                                <Label.FontColorOverride>#cbd5e1</Label.FontColorOverride>
                            </Label>
                            <CheckBox Name="AllowCarryCheckbox"/>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <!-- Right Panel - Map -->
            <BoxContainer Orientation="Vertical" SetWidth="990" SeparationOverride="6">
                <!-- Map -->
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="PROJECTION MAP" StyleClasses="LabelHeading">
                            <Label.FontColorOverride>#10b981</Label.FontColorOverride>
                        </Label>
                        <Label Name="ProjectorCountLabel" Text="0 Projectors" StyleClasses="LabelSmall">
                            <Label.FontColorOverride>#9ca3af</Label.FontColorOverride>
                        </Label>
                    </BoxContainer>
                    
                    <PanelContainer SetHeight="730" StyleClasses="AngleRect">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0a0e1a"/>
                        </PanelContainer.PanelOverride>
                        <ui:HologramConsoleNavMapControl Name="NavMap" HorizontalExpand="True" VerticalExpand="True"/>
                    </PanelContainer>
                </BoxContainer>

                <!-- Controls -->
                <PanelContainer StyleClasses="AngleRect">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#0f172a"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                        <Label Name="ControlsLabel" Text="PROJECTION CONTROLS" StyleClasses="LabelSmall">
                            <Label.FontColorOverride>#cbd5e1</Label.FontColorOverride>
                        </Label>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <Button Name="ProjectButton" Text="▶ PROJECT" Disabled="True" MinSize="300 50" StyleClasses="OpenBoth" />
                            <Button Name="RecallButton" Text="◼ RECALL" Disabled="True" MinSize="300 50" StyleClasses="OpenBoth" />
                        </BoxContainer>
                        <Label Name="PortableInfoLabel" Text="" StyleClasses="LabelSmall" Visible="False" Margin="4 0 0 0">
                            <Label.FontColorOverride>#9ca3af</Label.FontColorOverride>
                        </Label>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
