<ui:HologramConsoleWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:ui="clr-namespace:Content.Client._Starlight.Holograms.UI"
               SetSize="1200 850"
               MinSize="1200 850"
               Resizable="False"
               MouseFilter="Stop">
    <PanelContainer Name="Background" StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#4a5466" />
    <PanelContainer Name="Border" StyleClasses="PdaBorderRect" />
    
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <!-- Window Top Bar for dragging -->
        <BoxContainer SetHeight="30"
                      Margin="4 2 8 0"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right">
        </BoxContainer>
        
        <!--Content-->
        <Control Margin="24 0 24 24"
                 RectClipContent="True"
                 VerticalExpand="True"
                 HorizontalExpand="True"
                 Modulate="#3badd6">
            <!-- Window Background -->
            <PanelContainer Name="ContentBorder" StyleClasses="PdaBackground" />
            
            <!-- Screen Background -->
            <PanelContainer Name="ContentBackground" StyleClasses="PdaContentBackground" />
            
            <!-- Screen foreground -->
            <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                <!-- Header -->
                <BoxContainer Orientation="Horizontal" SeparationOverride="10" SetHeight="50" MinSize="0 50">
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center" MinSize="200 0" HorizontalExpand="True">
                        <Label Name="StatusLabel" 
                               Text="System Ready"
                               MinSize="0 20">
                        </Label>
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center" MinSize="150 0">
                        <Label Name="ActiveIndicator"
                               Text="● INACTIVE"
                               MinSize="0 20">
                        </Label>
                        <Label Name="ModeLabel"
                               Text=""
                               StyleClasses="LabelSmall"
                               Visible="False"
                               MinSize="0 16">
                        </Label>
                    </BoxContainer>
                    <!-- Battery Status -->
                    <PanelContainer Name="BatteryPanel" Visible="False" MinSize="140 38" SetHeight="38">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1a2a45" BorderColor="#3a5a8f" BorderThickness="2 2 2 2"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Horizontal" Margin="8 6" SeparationOverride="6" VerticalAlignment="Center">
                            <!-- Battery Icon -->
                            <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
                                <PanelContainer MinSize="3 14" MaxSize="3 14">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#6b7280"/>
                                    </PanelContainer.PanelOverride>
                                </PanelContainer>
                                <PanelContainer MinSize="34 20" MaxSize="34 20">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#1e293b" BorderColor="#6b7280" BorderThickness="1 1 1 1"/>
                                    </PanelContainer.PanelOverride>
                                    <ProgressBar Name="BatteryBar" Value="1.0" MinHeight="18" Margin="1" VerticalAlignment="Stretch">
                                <ProgressBar.ForegroundStyleBoxOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#10b981"/>
                                </ProgressBar.ForegroundStyleBoxOverride>
                                <ProgressBar.BackgroundStyleBoxOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#00000000"/>
                                </ProgressBar.BackgroundStyleBoxOverride>
                            </ProgressBar>
                                </PanelContainer>
                            </BoxContainer>
                            <Label Name="BatteryLabel" Text="100%" StyleClasses="LabelSmall" MinSize="40 0">
                            </Label>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <!-- Main Content -->
                <BoxContainer Orientation="Horizontal" SeparationOverride="12" VerticalExpand="True" MinSize="0 550">
                    <!-- Left Panel - HOLOGRAM LIST -->
                    <BoxContainer Name="LeftPanel" Orientation="Vertical" SetWidth="420" MinSize="420 0" SeparationOverride="8" VerticalExpand="True">
                        <Label Text="HOLOGRAMS" HorizontalAlignment="Center" SetHeight="24" MinSize="0 24">
                        </Label>

                        <PanelContainer VerticalExpand="True" HorizontalExpand="True" MinSize="400 350">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1a2a45" BorderColor="#3a5a8f" BorderThickness="2 2 2 2"/>
                    </PanelContainer.PanelOverride>
                            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                                <BoxContainer Name="BladeServersList" Orientation="Vertical" Margin="8" SeparationOverride="6" MinSize="380 0"/>
                            </ScrollContainer>
                            <Label Name="NoBladeServersLabel"
                                   Text="NO HOLOGRAMS FOUND"
                                   StyleClasses="LabelSmall"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visible="False"/>
                        </PanelContainer>

                        <!-- Settings -->
                        <PanelContainer Name="SettingsPanel" Visible="False" MinSize="400 70" SetHeight="70">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1a2a45" BorderColor="#3a5a8f" BorderThickness="2 2 2 2"/>
                    </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
                                <Label Text="PORTABLE SETTINGS" MinSize="0 20">
                                </Label>
                                <BoxContainer Orientation="Horizontal" MinSize="0 28">
                                    <Label Text="Allow Hologram Carry" VerticalAlignment="Center" MinSize="180 0" HorizontalExpand="True">
                                    </Label>
                                    <CheckBox Name="AllowCarryCheckbox" MinSize="28 28"/>
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>

                        <!-- Controls -->
                        <PanelContainer Name="ControlsPanel" MinSize="400 150">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1a2a45" BorderColor="#3a5a8f" BorderThickness="2 2 2 2"/>
                    </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True">
                                    <Button Name="ProjectButton" Text="▶ PROJECT" Disabled="True" MinSize="380 55" SetHeight="55" HorizontalExpand="True" StyleClasses="OpenBoth" />
                                    <Button Name="RecallButton" Text="◼ RECALL" Disabled="True" MinSize="380 55" SetHeight="55" HorizontalExpand="True" StyleClasses="OpenBoth" />
                                </BoxContainer>
                                <Label Name="PortableInfoLabel" Text="" StyleClasses="LabelSmall" Visible="False" Margin="6 0 0 0" MinSize="0 18">
                                </Label>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>

                    <!-- Right Panel - Map -->
                    <BoxContainer Name="MapPanel" Orientation="Vertical" SeparationOverride="8" MinSize="700 0" VerticalExpand="True" HorizontalExpand="True">
                        <!-- Map -->
                        <BoxContainer Orientation="Vertical" SeparationOverride="8" VerticalExpand="True">
                            <BoxContainer Orientation="Horizontal" SetHeight="24" MinSize="0 24">
                                <Label Text="PROJECTION MAP" MinSize="150 0" HorizontalExpand="True">
                                </Label>
                                <Label Name="ProjectorCountLabel" Text="0 Projectors" MinSize="120 0">
                                </Label>
                            </BoxContainer>

                            <PanelContainer VerticalExpand="True" HorizontalExpand="True" MinSize="680 580">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#1a2a45" BorderColor="#3a5a8f" BorderThickness="2 2 2 2"/>
                                </PanelContainer.PanelOverride>
                                <ui:HologramConsoleNavMapControl Name="NavMap" MinSize="676 576" VerticalExpand="True" HorizontalExpand="True"/>
                                <!-- Overlay panel that covers NavMap when no server connected -->
                                <PanelContainer Name="NoServerOverlay" Visible="False" VerticalExpand="True" HorizontalExpand="True">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#1a2a45"/>
                                    </PanelContainer.PanelOverride>
                                    <Label Name="NoServerMapLabel"
                                           Text="NO SERVER CONNECTED"
                                           StyleClasses="LabelSmall"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </PanelContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </Control>
    </BoxContainer>
</ui:HologramConsoleWindow>
