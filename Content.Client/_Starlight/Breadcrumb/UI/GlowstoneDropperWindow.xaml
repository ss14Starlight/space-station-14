<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:sl-controls="clr-namespace:Content.Client._Starlight.UserInterface.Controls"
                      Title="{Loc 'glowstone-dropper-ui-window'}"
                      MinSize="320 120">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">

        <!-- Color -->
        <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
            <Label Text="{Loc 'glowstone-dropper-ui-color'}"
                   MinWidth="80"
                   VerticalAlignment="Center" />
            <sl-controls:ColoredOptionButton
                Name="ColorSelector"
                ToolTip="{Loc 'glowstone-dropper-ui-color-tooltip'}"
                HorizontalExpand="True" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 4 0 4" />

        <Button Name="SubmitButton"
                Text="{Loc 'glowstone-dropper-ui-submit'}"
                HorizontalExpand="True" />

    </BoxContainer>
</controls:FancyWindow>
