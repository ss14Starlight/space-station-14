<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._Starlight.Computers.TacticalPlanning.UI"
                      Title="{Loc 'tactical-planning-console-title'}"
                      Resizable="True"
                      SetSize="1080 760"
                      MinSize="840 580">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <ui:TacticalPlanningMapControl Name="NavMapScreen" Margin="5 5" HorizontalExpand="True" VerticalExpand="True" />

            <BoxContainer Orientation="Vertical" SetWidth="340" Margin="0 0 10 10" VerticalExpand="True">
                <controls:StripeBack>
                    <PanelContainer>
                        <Label Name="StationName" Text="{Loc 'station-map-unknown-station'}" HorizontalAlignment="Center" Margin="0 5 0 3" />
                    </PanelContainer>
                </controls:StripeBack>

                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="0 10 0 0">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="10 10 10 10">
                        <Label Text="{Loc 'tactical-planning-console-active-tool'}" StyleClasses="LabelBig" Margin="0 0 0 6" />
                        <Button Name="DrawTool" Text="{Loc 'tactical-planning-console-draw-tool'}" HorizontalExpand="True" />
                        <Button Name="EraseTool" Text="{Loc 'tactical-planning-console-erase-tool'}" HorizontalExpand="True" Margin="0 4 0 0" />
                        <Button Name="IconsTool" Text="{Loc 'tactical-planning-console-icons-tool'}" HorizontalExpand="True" Margin="0 4 0 0" Visible="False" />

                        <PanelContainer StyleClasses="LowDivider" Margin="0 14 0 9" />
                        <BoxContainer Name="InkControls" Orientation="Vertical" HorizontalExpand="True">
                            <Label Text="{Loc 'tactical-planning-console-ink-color'}" StyleClasses="LabelBig" />
                            <BoxContainer Orientation="Horizontal" Margin="0 7 0 8">
                                <PanelContainer Name="InkPreview" SetSize="24 24" />
                                <Label Text="{Loc 'tactical-planning-console-current-ink'}" Margin="8 4 0 0" />
                                <Label Name="InkHex" Text="#FF4500" HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 4 0 0" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" Margin="0 7 0 0">
                                <Button Name="RedInk" Text="{Loc 'tactical-planning-console-red'}" HorizontalExpand="True" />
                                <Button Name="BlueInk" Text="{Loc 'tactical-planning-console-blue'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                                <Button Name="YellowInk" Text="{Loc 'tactical-planning-console-yellow'}" HorizontalExpand="True" />
                                <Button Name="VioletInk" Text="{Loc 'tactical-planning-console-violet'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <Label Text="{Loc 'tactical-planning-console-custom-color'}" StyleClasses="LabelBig" Margin="0 13 0 5" />
                            <LayoutContainer HorizontalExpand="True">
                                <ColorSelectorSliders Name="CustomColorPicker" IsAlphaVisible="False" />
                                <!-- Covers the picker while the shared plan is still connecting. -->
                                <Control Name="ColorPickerBlocker" />
                            </LayoutContainer>
                        </BoxContainer>
                        <BoxContainer Name="IconControls" Orientation="Vertical" HorizontalExpand="True" Visible="False">
                            <GridContainer Name="IconGrid" Columns="3" HorizontalExpand="True" HSeparationOverride="4" VSeparationOverride="4" />
                        </BoxContainer>
                        <BoxContainer Name="SelectionDetails" Orientation="Vertical" HorizontalExpand="True" Visible="False">
                            <PanelContainer StyleClasses="LowDivider" Margin="0 14 0 9" />
                            <RichTextLabel Name="Details" HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </ScrollContainer>

                <Label Name="ConnectionStatus" Text="{Loc 'tactical-planning-console-connecting'}" Margin="8 9 0 0" />
                <Label Name="AnnotationCount" Text="{Loc 'tactical-planning-console-initial-count'}" Margin="8 4 0 0" />
                <controls:ConfirmButton Name="ResetPlan" Text="{Loc 'tactical-planning-console-reset'}" ConfirmationText="{Loc 'tactical-planning-console-reset-confirm'}"
                                        Visible="False" Margin="8 5 0 0" />
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" />
        <BoxContainer Orientation="Horizontal" Margin="10 3 10 2">
            <Label Text="{Loc 'tactical-planning-console-footer'}"
                   StyleClasses="WindowFooterText" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
