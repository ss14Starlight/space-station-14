<Control xmlns="https://spacestation14.io">
    <!-- Laid out like the markings of the body tab: what's installed, then cards to install -->
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
        <Label Name="CyberneticsPoints" StyleClasses="LabelSubText" />
        <WrapContainer Name="InstalledCybernetics" SeparationOverride="4" CrossSeparationOverride="4" />
        <PanelContainer StyleClasses="InsetPanel" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True" ReserveScrollbarSpace="True">
                <WrapContainer Name="AvailableCybernetics" SeparationOverride="4" CrossSeparationOverride="4" Margin="4" />
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</Control>
