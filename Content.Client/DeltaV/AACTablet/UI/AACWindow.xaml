<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'aac-tablet-title'}"
    Resizable="True"
    SetSize="650 400"
    MinSize="450 250">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="4">
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'aac-window-search-placeholder'}" HorizontalExpand="True" Margin="0 0 0 4" />
        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <TabContainer Name="WindowBody" VerticalExpand="True" HorizontalExpand="True" />
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
