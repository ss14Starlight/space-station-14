<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls">
    <!-- Starlight-start -->
    <BoxContainer Name="VBox" Orientation="Vertical">
        <BoxContainer Name="Loaded" Orientation="Vertical" Visible="False" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <PanelContainer StyleClasses="SpritePreview">
                    <profile:ProfilePreviewSpriteView Name="ProfilePreviewSpriteView"
                                                      OverrideDirection="South"
                                                      Scale="3 3"
                                                      SetSize="96 96"
                                                      Access="Public" />
                </PanelContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Name="CharacterName" StyleClasses="LabelHeading" ClipText="True" />
                    <Label Name="CharacterJob" StyleClasses="LabelSubText" ClipText="True" />
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}" HorizontalExpand="True" />
                <Button Name="JobPriorities" Text="{Loc 'lobby-character-preview-panel-job-priorities-button'}" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" />
    </BoxContainer>
	<!-- Starlight-end -->
</Control>
