<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         VerticalExpand="True">
    <Control>
        <PanelContainer Name="BackgroundPanel" />
        <BoxContainer Orientation="Vertical" SeparationOverride="0">

            <!-- This holds the buttons in the top right of the window -->
            <!-- Starlight-start: only shown in a desktop window, an in-game window has its own header -->
            <BoxContainer Name="HeaderBar" Access="Public" Orientation="Vertical">
                <BoxContainer Orientation="Horizontal" MinSize="0 32">
                    <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                           Margin="8 0 0 0" VAlign="Center" HorizontalExpand="True"
                           StyleClasses="LabelHeading" />
                    <Button Name="CloseButton"
                            Access="Public"
                            Text="{Loc 'character-setup-gui-character-setup-close-button'}" />
                </BoxContainer>
                <PanelContainer StyleClasses="highlight" MinHeight="2" />
            </BoxContainer>
			<!-- Starlight-end -->
            <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="0">

                <!-- This box holds all the character pickers and job priority button, the left side of the window  -->
                <BoxContainer Name="CharacterPickerPanel" Access="Public" SetWidth="340" Margin="5 0 5 0" Orientation="Vertical">

                    <!-- This is the box where we stuff the character picker buttons into -->
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="0 5 0 0">
                        <BoxContainer Name="Characters" Orientation="Vertical" />
                    </ScrollContainer>

                    <!-- Starlight-start: these were in a bar of their own over the window, two by two so the words fit -->
                    <PanelContainer StyleClasses="LowDivider" />
                    <GridContainer Columns="2" HSeparationOverride="4" VSeparationOverride="4" Margin="0 5">
                        <Button Name="JobPrioritiesButton" HorizontalExpand="True" ClipText="True"
                                Text="{Loc 'character-setup-gui-edit-job-priorities-button'}" />
                        <Button Name="StatsButton" HorizontalExpand="True" ClipText="True"
                                Text="{Loc 'character-setup-gui-character-setup-stats-button'}" />
                        <cc:CommandButton Name="AdminRemarksButton" HorizontalExpand="True" ClipText="True"
                                          Command="adminremarks"
                                          Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}" />
                        <Button Name="RulesButton" HorizontalExpand="True" ClipText="True"
                                Text="{Loc 'character-setup-gui-character-setup-rules-button'}" />
                    </GridContainer>
				    <!-- Starlight-end -->
                </BoxContainer> <!-- End "Left side of the window" -->

                <!-- Vertical rule -->
                <PanelContainer MinSize="2 0" StyleClasses="highlight">
                </PanelContainer>

                <!-- The "right" side of the window, where the character and priority editors are instantiated -->
                <BoxContainer Name="CharEditor" HorizontalExpand="True" />
                <BoxContainer Name="JobPriorityEditor" HorizontalExpand="True" Visible="False"/>
            </BoxContainer>
        </BoxContainer>
    </Control>
</Control>
