<ContainerButton xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         HorizontalExpand="True">
    <BoxContainer Orientation="Horizontal"
                  HorizontalExpand="True"
                  SeparationOverride="0"
                  Name="InternalHBox">

        <!-- Left side: sprite preview -->
        <profile:ProfilePreviewSpriteView Scale="2 2"
                                          Margin="0 4 4 4"
                                          OverrideDirection="South"
                                          Name="View"
                                          SetSize="64 64"/>

        <!-- Name and job text -->
        <Label Name="DescriptionLabel" HorizontalExpand="True" ClipText="True"/>

        <!-- Vertical rule to separate the buttons -->
        <PanelContainer Name="ButtonDivider" MinSize="1 0" StyleClasses="LowDivider" Margin="0 6" /> <!-- Starlight-edit -->

        <!-- Container to hold the enable and delete buttons -->
        <!-- Starlight-edit: icons instead of words -->
        <BoxContainer Name="ButtonBox" Orientation="Vertical" VerticalAlignment="Center" VerticalExpand="True"
                      SeparationOverride="4" Margin="6 0 4 0">

            <!-- Enabled button -->
			<!-- Starlight-start -->
            <PanelContainer Name="EnabledCheckOutline">
                <Button Name="EnabledCheck" ToggleMode="True" SetSize="28 28" StyleClasses="ButtonSquare">
                    <TextureRect Name="EnabledIcon" Stretch="KeepCentered" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TextureScale="0.5 0.5" StyleClasses="CharacterPickerIcon" />
                </Button>
            </PanelContainer>
			<!-- Starlight-end -->

            <!-- Delete button -->
			<!-- Starlight-start -->
            <PanelContainer Name="DeleteButtonOutline" Visible="False">
                <controls:ConfirmButton Name="DeleteButton" SetSize="28 28" StyleClasses="ButtonSquare"
                                        ConfirmationText="" ToolTip="{Loc 'character-setup-gui-character-picker-button-delete-tooltip'}">
                    <TextureRect TexturePath="/Textures/Interface/VerbIcons/delete_transparent.svg.192dpi.png"
                                 Stretch="KeepCentered" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TextureScale="0.4 0.4" StyleClasses="CharacterPickerIcon" />
                </controls:ConfirmButton>
            </PanelContainer>
			<!-- Starlight-end -->
        </BoxContainer> <!-- End button container -->
    </BoxContainer>
</ContainerButton>
