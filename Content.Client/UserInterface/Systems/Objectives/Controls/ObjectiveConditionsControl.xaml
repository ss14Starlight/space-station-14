<controls:ObjectiveConditionsControl
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Systems.Objectives.Controls"
    Margin="2 0">
    <LayoutContainer HorizontalExpand="True" Name="InfoBox">
        <ProgressBar Name="ProgressBar" MinValue="0" MaxValue="1"
                     LayoutContainer.AnchorRight="1"
                     LayoutContainer.AnchorBottom="1"/>
        <BoxContainer Orientation="Vertical"
                      Margin="5"
                      LayoutContainer.AnchorRight="1"
                      LayoutContainer.AnchorBottom="1">
            <BoxContainer Orientation="Horizontal">
                <cc:ProgressTextureRect Name="ProgressTexture" VerticalAlignment="Center" Access="Public"/>
                <Control MinSize="10 0"/>
                <RichTextLabel Name="Title" Access="Public" HorizontalExpand="True" HorizontalAlignment="Left"/>
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" Margin="0 4"/>
            <RichTextLabel Name="Description" Access="Public" HorizontalExpand="True" HorizontalAlignment="Left"/>
        </BoxContainer>
    </LayoutContainer>
</controls:ObjectiveConditionsControl>
